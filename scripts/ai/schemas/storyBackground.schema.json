{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryBackgroundDraft",
  "type": "object",
  "required": ["title", "premise", "facilityLine", "victoryLine", "motifsUsed"],
  "properties": {
    "title": { "type": "object", "required": ["zh", "en"], "properties": { "zh": { "type": "string" }, "en": { "type": "string" } } },
    "premise": { "type": "object", "required": ["zh", "en"], "properties": { "zh": { "type": "string" }, "en": { "type": "string" } } },
    "facilityLine": { "type": "object", "required": ["zh", "en"], "properties": { "zh": { "type": "string" }, "en": { "type": "string" } } },
    "victoryLine": { "type": "object", "required": ["zh", "en"], "properties": { "zh": { "type": "string" }, "en": { "type": "string" } } },
    "motifsUsed": { "type": "array", "items": { "type": "string" } }
  }
}
