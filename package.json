{
  "name": "human-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/optimizer/generate-pwa-sw.mjs",
    "i18n:qa": "node scripts/qa/i18n-coverage-qa.mjs",
    "qa:gltf": "node scripts/qa/gltf-validate.mjs",
    "qa:viewmodel-production-assets": "node scripts/qa/viewmodel-production-assets-qa.mjs",
    "qa:viewmodel-scripted-derived-assets": "node scripts/qa/viewmodel-scripted-derived-assets-qa.mjs",
    "qa:viewmodel-sidearm-real-layered": "node scripts/qa/viewmodel-sidearm-real-layered-asset-qa.mjs",
    "assets:viewmodel-production:blender": "/Applications/Blender.app/Contents/MacOS/blender --background --python scripts/asset-build/blender-generate-viewmodel-production-prototypes.py",
    "assets:viewmodel-scripted-derived:blender": "/Applications/Blender.app/Contents/MacOS/blender --background --python scripts/asset-build/blender-derive-scripted-viewmodel-prototypes.py",
    "assets:viewmodel-sidearm-real-layered:blender": "/Applications/Blender.app/Contents/MacOS/blender --background --python scripts/asset-build/blender-generate-sidearm-real-layered-viewmodel.py && npx --yes @gltf-transform/cli resize work/scripted-derived/hp_viewmodel_sidearm_scripted_derived_v2_unoptimized.glb work/scripted-derived/hp_viewmodel_sidearm_scripted_derived_v2_1024.glb --width 1024 --height 1024 && npx --yes @gltf-transform/cli webp work/scripted-derived/hp_viewmodel_sidearm_scripted_derived_v2_1024.glb work/scripted-derived/hp_viewmodel_sidearm_scripted_derived_v2_webp.glb --quality 86 --effort 80 && npx --yes @gltf-transform/cli meshopt work/scripted-derived/hp_viewmodel_sidearm_scripted_derived_v2_webp.glb src/assets/models/viewmodel/prototypes/hp_viewmodel_sidearm_scripted_derived_v2.glb --level high",
    "qa:render-plan": "node scripts/qa/render-plan-audit.mjs",
    "qa:root-menu": "node scripts/qa/root-menu-browser-qa.mjs",
    "qa:physics:browser": "node scripts/qa/physics-browser-qa.mjs",
    "clean:runtime": "rm -rf dist node_modules/.vite node_modules/.tmp .tmp",
    "smoke:campaign": "node scripts/qa/smoke-campaign.mjs",
    "smoke:age-adapter": "tsx --tsconfig tsconfig.app.json scripts/qa/age-adapter-smoke.ts",
    "qa:builder:browser": "node scripts/qa/builder-deep-browser-qa.mjs",
    "qa:builder:wgpu-assets": "node scripts/qa/builder-wgpu-resource-audit.mjs",
    "qa:visual-bake-contract": "node scripts/qa/visual-bake-contract.mjs",
    "qa:builder-to-official": "node scripts/qa/builder-to-official-pipeline-qa.mjs",
    "qa:build-official": "node scripts/qa/build-official-source-qa.mjs",
    "build-official:level03:rebuild-raw": "npm run qa:build-official && npm run raw-webgpu:level03:rebuild && npm run qa:visual-bake-contract",
    "qa:level3:visual-contract": "node scripts/qa/level3-visual-contract.mjs",
    "qa:level3:boss-visual-contract": "node scripts/qa/level03-boss-visual-contract-qa.mjs",
    "qa:builder": "node scripts/qa/builder-headless-check.mjs",
    "qa:builder:shapes": "node scripts/qa/shaped-room-check.mjs",
    "perf:campaign": "node scripts/qa/performance-budget-smoke.mjs",
    "compile:raw-webgpu-plan": "node tools/raw-webgpu-compiler/compile-raw-webgpu-render-plan.mjs",
    "qa:playthrough": "node scripts/qa/real-playthrough-qa.mjs",
    "qa:playthrough:rapier": "node scripts/qa/real-playthrough-qa.mjs --physics=rapier",
    "art:qa": "node scripts/qa/art-config-qa.mjs",
    "lighting:qa": "node scripts/qa/lighting-qa.mjs",
    "lighting:search:cpp": "node scripts/optimizer/run-lighting-search.mjs",
    "raw-webgpu:lighting:cpp": "node scripts/optimizer/run-level03-raw-lighting-optimizer.mjs",
    "raw-webgpu:color:cpp": "node scripts/optimizer/run-level03-raw-color-grade-optimizer.mjs",
    "raw-webgpu:palette:cpp": "node scripts/optimizer/run-raw-webgpu-role-palette-solver.mjs",
    "raw-webgpu:palette:solve": "node scripts/optimizer/run-raw-webgpu-role-palette-solver.mjs",
    "raw-webgpu:palette:rebuild": "npm run compile:raw-webgpu-plan -- --no-raw-role-palette-tuning && npm run raw-webgpu:palette:solve && npm run compile:raw-webgpu-plan",
    "raw-webgpu:color:audit": "node scripts/qa/raw-webgpu-color-quality-audit.mjs",
    "museum:lighting:qa": "node scripts/qa/museum-lighting-qa.mjs",
    "raw-webgpu:material:pipeline": "node scripts/asset-build/build-raw-webgpu-material-pipeline.mjs",
    "raw-webgpu:material:rebuild": "npm run compile:raw-webgpu-plan -- --no-raw-material-pipeline && npm run raw-webgpu:material:pipeline && npm run compile:raw-webgpu-plan",
    "raw-webgpu:rebuild": "node scripts/asset-build/rebuild-raw-webgpu-levels.mjs",
    "raw-webgpu:rebuild:all": "node scripts/asset-build/rebuild-raw-webgpu-levels.mjs --level=all",
    "raw-webgpu:rebuild:all:build": "node scripts/asset-build/rebuild-raw-webgpu-levels.mjs --level=all --build",
    "raw-webgpu:level03:rebuild": "node scripts/asset-build/rebuild-raw-webgpu-levels.mjs --level=level_03_human_museum --level3-lighting --write-threejs-bridge --build",
    "raw-webgpu:level03:beautify": "node scripts/asset-build/beautify-level03-raw-webgpu-profile.mjs",
    "raw-webgpu:threejs:prepare": "node scripts/asset-build/prepare-level03-threejs-raw-assets.mjs",
    "raw-webgpu:threejs:prepare:audit": "node scripts/asset-build/prepare-level03-threejs-raw-assets.mjs --audit-only",
    "raw-webgpu:threejs:prepare:archive": "node scripts/asset-build/prepare-level03-threejs-raw-assets.mjs --include-source-art --copy-originals --gzip",
    "raw-webgpu:loader:cooked": "node scripts/asset-build/build-raw-webgpu-cooked-loader-manifest.mjs",
    "raw-webgpu:robot-animation:qa": "node scripts/qa/raw-webgpu-robot-animation-qa.mjs",
    "lighting:screenshot:qa": "node scripts/qa/lighting-screenshot-qa.mjs",
    "enemy:color:qa": "node scripts/qa/enemy-color-qa.mjs",
    "enemy:asset:qa": "node scripts/qa/enemy-asset-qa.mjs",
    "enemy:geometry:search": "node scripts/optimizer/enemy-glb-geometry-objective-v1.mjs",
    "enemy:aesthetic:search": "node scripts/optimizer/enemy-aesthetic-objective-v2.mjs",
    "enemy:blender:evolve": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/blender-evolve-enemy-aesthetic-v2.py",
    "check:budget": "node scripts/qa/check-package-budget.mjs",
    "gui:math-audit": "node scripts/qa/gui-math-audit.mjs",
    "gui:layout-audit": "node scripts/qa/gui-layout-audit.mjs",
    "optimize:glb": "node scripts/asset-build/optimize-glb.mjs",
    "decimate:glb": "node scripts/asset-build/decimate-glb.mjs",
    "assets:textures:visually-lossless": "node scripts/asset-build/compress-visually-lossless-textures.mjs",
    "assets:textures:visually-lossless:audit": "node scripts/asset-build/compress-visually-lossless-textures.mjs --audit",
    "assets:textures:visually-lossless:write": "node scripts/asset-build/compress-visually-lossless-textures.mjs --write",
    "cook:runtime-glb": "node scripts/asset-build/cook-runtime-glbs.mjs",
    "assets:environment:generate": "node scripts/optimizer/generate-environment-assets.mjs",
    "assets:environment:validate": "node scripts/qa/validate-environment-assets.mjs",
    "assets:furniture:pipeline": "node scripts/asset-build/furniture-asset-pipeline.mjs",
    "assets:math-polish": "node scripts/optimizer/math-polish-assets-v1.mjs",
    "assets:level02:furniture:search": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_furniture_objective_v1.cpp -o .tmp/level02_furniture_objective_v1 && .tmp/level02_furniture_objective_v1 --families=50000 --candidates=5000000",
    "assets:level02:story-art:search": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_story_art_objective_v1.cpp -o .tmp/level02_story_art_objective_v1 && .tmp/level02_story_art_objective_v1 --families=50000 --candidates=5000000",
    "assets:level02:furniture:blender": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/blender-generate-level02-furniture.py",
    "assets:service-elevator:blender": "blender --background --python scripts/asset-build/blender-generate-service-elevator-exit-kit.py",
    "assets:level02:runtime-lite": "node scripts/asset-build/cook-level02-runtime-lite.mjs",
    "build:platform": "npm run build && npm run check:budget",
    "package:platform": "npm run build:platform && node scripts/asset-build/package-platform.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "assets:level02:texture:audit": "node scripts/qa/level02-texture-visibility-audit.mjs",
    "assets:level02:furniture:search:v2": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_furniture_objective_v2.cpp -o .tmp/level02_furniture_objective_v2 && .tmp/level02_furniture_objective_v2 --families=20000 --candidates=2000000",
    "assets:level02:lighting:search:v2": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_lighting_objective_v2.cpp -o .tmp/level02_lighting_objective_v2 && .tmp/level02_lighting_objective_v2 --families=24000 --candidates=24000000",
    "assets:level02:lighting:search:v3": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_lighting_objective_v3.cpp -o .tmp/level02_lighting_objective_v3 && .tmp/level02_lighting_objective_v3 --families=24000 --candidates=24000000",
    "assets:level02:lighting:search:v4": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level02_lighting_objective_v4.cpp -o .tmp/level02_lighting_objective_v4 && .tmp/level02_lighting_objective_v4 --families=48000 --candidates=48000000",
    "assets:level01:lighting:search:v5": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level01_lighting_director_objective_v5.cpp -o .tmp/level01_lighting_director_objective_v5 && .tmp/level01_lighting_director_objective_v5 --families=3000 --candidates=160",
    "assets:level01:reference-decals": "python3 scripts/asset-build/generate-level01-reference-decals.py",
    "assets:level01:raw-support": "npm run assets:level01:reference-decals",
    "assets:level03:museum:search": "mkdir -p .tmp && c++ -O3 -std=c++17 scripts/optimizer/level03_museum_art_objective_v1.cpp -o .tmp/level03_museum_art_objective_v1 && .tmp/level03_museum_art_objective_v1 --families=10000 --candidates=10000000",
    "assets:level03:museum:blender": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/blender-generate-level03-museum-assets.py",
    "assets:level03:museum:shell:blender": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/blender-generate-level03-museum-shell-assets.py",
    "assets:furniture:batch01:blender": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/blender-generate-furniture-factory-batch01.py",
    "assets:skill3:breach-charge": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/generate-skill3-protocol-breach-charge.py",
    "assets:wall-door-switch:blender": "/Applications/Blender.app/Contents/MacOS/Blender --background --python scripts/asset-build/generate-wall-door-switch-button-glb.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "sharp": "^0.35.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
